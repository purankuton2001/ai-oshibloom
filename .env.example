PORT=8790
DATA_DIR=./data
# Defaults are free and offline. Select fal in the studio to enable paid generation.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_EDIT_MODEL=fal-ai/flux-pro/kontext
FAL_VIDEO_MODEL=minimax/h3-max/reference-to-video
FAL_TTS_MODEL=fal-ai/minimax/speech-02-hd
# Preset synthetic voice ID only. Never use a cloned real person's voice.
FAL_VOICE_ID=English_Graceful_Lady
OPENAI_API_KEY=
REPLY_MODEL=gpt-4o-mini
YOUTUBE_API_KEY=
# Optional local ComfyUI API workflow; see local/README.md
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=./local/workflow.json
# Estimates only; provider invoices remain authoritative.
PRICE_VIDEO_SECOND=0.08
PRICE_VIDEO_REFERENCE=0.02
PRICE_IMAGE=0.03
PRICE_EDIT=0.04
PRICE_VOICE=0.02
REQUEST_TIMEOUT_MS=120000

FAL_REPLY_MODEL=google/gemini-2.5-flash
PRICE_REPLY=0.003

# Used to derive matching reaction framing from the idle video.
FFMPEG_BINARY=ffmpeg

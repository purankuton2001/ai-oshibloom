{
  "name": "ai-oshibloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "esbuild client/director.js --bundle --format=esm --outfile=public/director-client.js && tsc",
    "start:prod": "node dist/src/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "probe": "tsx src/probe.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.11.0-alpha.2",
    "@fal-ai/server-proxy": "^1.3.0-alpha.0",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
